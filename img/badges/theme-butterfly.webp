<svg xmlns="http://www.w3.org/2000/svg" width="118" height="20" role="img" aria-label="Theme: Butterfly">
<title>Theme: Butterfly</title>
<linearGradient id="s" x2="0" y2="100%">
  <stop offset="0" stop-color="#bbb" stop-opacity=".1"/>
  <stop offset="1" stop-opacity=".1"/>
</linearGradient>
<clipPath id="r"><rect width="118" height="20" rx="3"/></clipPath>
<g clip-path="url(#r)">
  <rect width="45" height="20" fill="#555"/>
  <rect x="45" width="73" height="20" fill="#6513df"/>
  <rect width="118" height="20" fill="url(#s)"/>
</g>
<g fill="#fff" text-anchor="middle" font-family="Verdana,Geneva,DejaVu Sans,sans-serif" font-size="110">
  <text x="225" y="150" fill="#010101" fill-opacity=".3" transform="scale(.1)" textLength="350">Theme</text>
  <text x="225" y="140" transform="scale(.1)" textLength="350">Theme</text>
  <text x="815" y="150" fill="#010101" fill-opacity=".3" transform="scale(.1)" textLength="630">Butterfly</text>
  <text x="815" y="140" transform="scale(.1)" textLength="630">Butterfly</text>
</g>
</svg>
