<svg xmlns="http://www.w3.org/2000/svg" width="104" height="20" role="img" aria-label="CDN: npmmirror">
<title>CDN: npmmirror</title>
<linearGradient id="s" x2="0" y2="100%">
  <stop offset="0" stop-color="#bbb" stop-opacity=".1"/>
  <stop offset="1" stop-opacity=".1"/>
</linearGradient>
<clipPath id="r"><rect width="104" height="20" rx="3"/></clipPath>
<g clip-path="url(#r)">
  <rect width="31" height="20" fill="#555"/>
