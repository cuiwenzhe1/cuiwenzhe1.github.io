<svg xmlns="http://www.w3.org/2000/svg" width="89" height="20" viewBox="0 0 89 20" role="img" aria-label="Frame: Hexo">
<title>Frame: Hexo</title>
<linearGradient id="shine" x2="0" y2="100%">
  <stop offset="0" stop-color="#fff" stop-opacity=".15"/>
  <stop offset="1" stop-opacity=".07"/>
</linearGradient>
<clipPath id="edge"><rect width="89" height="20" rx="3"/></clipPath>
<g clip-path="url(#edge)">
  <rect width="48" height="20" fill="#444c56"/>
  <rect x="48" width="41" height="20" fill="#0676b0"/>
  <rect width="89" height="20" fill="url(#shine)"/>
</g>
<g text-anchor="middle" font-family="Verdana,Geneva,DejaVu Sans,sans-serif" font-size="11">
  <text x="24" y="14" fill="#fff">Frame</text>
  <text x="68.5" y="14" fill="#fff">Hexo</text>
</g>
</svg>
