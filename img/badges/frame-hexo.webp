<svg xmlns="http://www.w3.org/2000/svg" width="83" height="20" role="img" aria-label="Frame: Hexo">
<title>Frame: Hexo</title>
<linearGradient id="s" x2="0" y2="100%">
  <stop offset="0" stop-color="#bbb" stop-opacity=".1"/>
  <stop offset="1" stop-opacity=".1"/>
</linearGradient>
<clipPath id="r"><rect width="83" height="20" rx="3"/></clipPath>
<g clip-path="url(#r)">
  <rect width="45" height="20" fill="#555"/>
  <rect x="45" width="38" height="20" fill="#0e83c"/>
  <rect width="83" height="20" fill="url(#s)"/>
</g>
<g fill="#fff" text-anchor="middle" font-family="Verdana,Geneva,DejaVu Sans,sans-serif" font-size="110">
  <text x="225" y="150" fill="#010101" fill-opacity=".3" transform="scale(.1)" textLength="350">Frame</text>
  <text x="225" y="140" transform="scale(.1)" textLength="350">Frame</text>
  <text x="640" y="150" fill="#010101" fill-opacity=".3" transform="scale(.1)" textLength="280">Hexo</text>
  <text x="640" y="140" transform="scale(.1)" textLength="280">Hexo</text>
</g>
</svg>
