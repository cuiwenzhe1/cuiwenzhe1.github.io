<svg xmlns="http://www.w3.org/2000/svg" width="102" height="20" viewBox="0 0 102 20" role="img" aria-label="Source: GitHub">
<title>Source: GitHub</title>
<linearGradient id="shine" x2="0" y2="100%">
  <stop offset="0" stop-color="#fff" stop-opacity=".15"/>
  <stop offset="1" stop-opacity=".07"/>
</linearGradient>
<clipPath id="edge"><rect width="102" height="20" rx="3"/></clipPath>
<g clip-path="url(#edge)">
  <rect width="52" height="20" fill="#444c56"/>
  <rect x="52" width="50" height="20" fill="#b422aa"/>
  <rect width="102" height="20" fill="url(#shine)"/>
</g>
<g text-anchor="middle" font-family="Verdana,Geneva,DejaVu Sans,sans-serif" font-size="11">
  <text x="26" y="14" fill="#fff">Source</text>
  <text x="77" y="14" fill="#fff">GitHub</text>
</g>
</svg>
