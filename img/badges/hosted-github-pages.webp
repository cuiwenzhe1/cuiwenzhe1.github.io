<svg xmlns="http://www.w3.org/2000/svg" width="132" height="20" role="img" aria-label="Host: GitHub Pages">
<title>Host: GitHub Pages</title>
<linearGradient id="s" x2="0" y2="100%">
  <stop offset="0" stop-color="#bbb" stop-opacity=".1"/>
  <stop offset="1" stop-opacity=".1"/>
</linearGradient>
<clipPath id="r"><rect width="132" height="20" rx="3"/></clipPath>
<g clip-path="url(#r)">
  <rect width="38" height="20" fill="#555"/>
  <rect x="38" width="94" height="20" fill="#2f6f9f"/>
  <rect width="132" height="20" fill="url(#s)"/>
</g>
<g fill="#fff" text-anchor="middle" font-family="Verdana,Geneva,DejaVu Sans,sans-serif" font-size="110">
  <text x="190" y="150" fill="#010101" fill-opacity=".3" transform="scale(.1)" textLength="280">Host</text>
  <text x="190" y="140" transform="scale(.1)" textLength="280">Host</text>
  <text x="850" y="150" fill="#010101" fill-opacity=".3" transform="scale(.1)" textLength="840">GitHub Pages</text>
  <text x="850" y="140" transform="scale(.1)" textLength="840">GitHub Pages</text>
</g>
</svg>
