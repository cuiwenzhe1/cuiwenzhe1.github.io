<svg xmlns="http://www.w3.org/2000/svg" width="125" height="20" viewBox="0 0 125 20" role="img" aria-label="Host: GitHub Pages">
<title>Host: GitHub Pages</title>
<linearGradient id="shine" x2="0" y2="100%">
  <stop offset="0" stop-color="#fff" stop-opacity=".15"/>
  <stop offset="1" stop-opacity=".07"/>
</linearGradient>
<clipPath id="edge"><rect width="125" height="20" rx="3"/></clipPath>
<g clip-path="url(#edge)">
  <rect width="37" height="20" fill="#444c56"/>
  <rect x="37" width="88" height="20" fill="#b1da7c"/>
  <rect width="125" height="20" fill="url(#shine)"/>
</g>
<g text-anchor="middle" font-family="Verdana,Geneva,DejaVu Sans,sans-serif" font-size="11">
  <text x="18.5" y="14" fill="#fff">Host</text>
  <text x="81" y="14" fill="#233720">GitHub Pages</text>
</g>
</svg>
